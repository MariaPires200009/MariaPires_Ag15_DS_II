<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="CadastroEventos.ResumoPage">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">
            <Label Text="Resumo do evento" FontSize="20" HorizontalOptions="Center"/>
            <Label Text="{Binding Nome}"/>

            <Label Text="{Binding Local}"/>

            <Label Text="{Binding DataInicio, StringFormat='Data de início: {0:dd/MM/yyyy}'}"/>

            <Label Text="{Binding DataFim, StringFormat='Data de término: {0:dd/MM/yyyy}'}"/>

            <Label Text="{Binding NumeroParticipantes, StringFormat='Número de participantes: {0}'}"/>

            <Label Text="{Binding CustoParticipante, StringFormat='Custo por participante: {0:C}'}"/>

            <Label Text="{Binding CustoTotal, StringFormat='Custo total do evento: {0:C}'}"/>

            <Label Text="{Binding Duracao, StringFormat='Duração do evento: {0} dias'}"/>

            <Label Text="{Binding Intervalo.Days, StringFormat='Intervalo entre início e término: {0} dias'}"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>